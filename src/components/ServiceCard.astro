---
import Icon from './Icon.astro';
interface Props {
  icono: string;
  titulo: string;
  texto: string;
  index: number;
}
const { icono, titulo, texto, index } = Astro.props;
---

<article class="service-card group relative flex h-full flex-col overflow-hidden rounded-3xl border border-navy/10 bg-white p-8 transition duration-500 hover:-translate-y-1 hover:border-navy hover:bg-navy hover:shadow-2xl hover:shadow-navy/25">
  <span class="spotlight pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100" aria-hidden="true"></span>
  <div class="relative flex items-start justify-between">
    <span class="grid h-14 w-14 place-items-center rounded-2xl bg-ivory text-gold-dark transition duration-500 group-hover:bg-gold group-hover:text-navy">
      <Icon name={icono} />
    </span>
    <span class="font-serif text-sm text-navy/30 transition duration-500 group-hover:text-gold-light/70">
      {String(index + 1).padStart(2, '0')}
    </span>
  </div>
  <h3 class="relative mt-8 text-xl font-bold transition duration-500 group-hover:text-white">{titulo}</h3>
  <p class="relative mt-3 leading-relaxed text-slate transition duration-500 group-hover:text-white/75">{texto}</p>
  <span class="relative mt-auto block h-px w-10 bg-gold pt-0 transition-all duration-500 group-hover:w-full" style="margin-top:2rem" aria-hidden="true"></span>
</article>

<style>
  .spotlight {
    background: radial-gradient(
      320px circle at var(--mx, 50%) var(--my, 0%),
      rgb(201 162 75 / 0.18),
      transparent 70%
    );
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.service-card').forEach((card) => {
    card.addEventListener('mousemove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`);
      card.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });
</script>
