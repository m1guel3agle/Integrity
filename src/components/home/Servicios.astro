---
import home from '../../content/home';
import ServiceCard from '../ServiceCard.astro';
const { servicios } = home;

interface Props {
  showAllButton?: boolean;
}
const { showAllButton = true } = Astro.props;
---

<section id="servicios" class="bg-white py-24 lg:py-32">
  <div class="container-x">
    <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
      <div class="max-w-2xl">
        <p class="eyebrow reveal text-gold-dark">{servicios.etiqueta}</p>
        <h2 class="reveal mt-5 text-3xl leading-tight font-extrabold tracking-tight text-balance sm:text-4xl xl:text-5xl" style="--delay:80ms">
          {servicios.titulo}
        </h2>
      </div>
      {showAllButton && (
        <a href="/servicios" class="btn-navy reveal shrink-0 self-start lg:self-auto" style="--delay:150ms">
          {servicios.boton}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      )}
    </div>

    <ul class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {servicios.items.map((s, i) => (
        <li class="reveal" style={`--delay:${(i % 3) * 100}ms`}>
          <ServiceCard {...s} index={i} />
        </li>
      ))}
    </ul>
  </div>
</section>
