---
import home from '../../content/home';
import sitio from '../../content/sitio.json';
const { contactoCta } = home;
---

<section class="relative overflow-hidden bg-gold py-20 text-navy">
  <div class="absolute inset-0 opacity-30 [background-image:repeating-linear-gradient(90deg,rgb(0_27_59/0.12)_0_1px,transparent_1px_72px)]" aria-hidden="true"></div>
  <div class="container-x relative flex flex-col items-start justify-between gap-10 lg:flex-row lg:items-center">
    <div class="max-w-2xl">
      <h2 class="reveal text-3xl leading-tight font-extrabold tracking-tight sm:text-4xl xl:text-5xl">{contactoCta.titulo}</h2>
      <p class="reveal mt-4 text-lg leading-relaxed text-navy/80" style="--delay:80ms">{contactoCta.texto}</p>
    </div>
    <div class="reveal flex flex-col items-start gap-4" style="--delay:160ms">
      <a href="/contacto" class="btn-navy !px-8 !py-4 text-base">
        {contactoCta.boton}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
      <a href={`mailto:${sitio.correo}`} class="text-sm font-semibold underline decoration-navy/30 underline-offset-4 hover:decoration-navy">{sitio.correo}</a>
    </div>
  </div>
</section>
