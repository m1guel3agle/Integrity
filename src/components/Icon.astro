---
// Íconos de línea para los servicios. El nombre se elige desde el CMS.
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = 'h-7 w-7' } = Astro.props;

const paths: Record<string, string> = {
  balanza:
    '<path d="M12 3v18M7 21h10M5 7h14M12 4.5 5 7M12 4.5 19 7"/><path d="M5 7l-3 7a3.5 3.5 0 0 0 6 0L5 7zM19 7l-3 7a3.5 3.5 0 0 0 6 0l-3-7z"/>',
